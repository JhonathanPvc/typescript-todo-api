generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String?
  email     String   @unique
  senha     String
  dataCriacao DateTime @default(now())
  dataEdicao DateTime @updatedAt

  @@map("Usuario.model")
}